# Copy to .env.local (local dev) and set the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → Database → Connection string. Use the transaction pooler (port 6543) on Vercel.
DATABASE_URL=postgres://postgres.YOUR-PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# AI drafts (Phase 1+)
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-sonnet-5-5
AI_MODEL_DEEP=claude-opus-5-5

# Protects /api/cron/dispatch. Generate: openssl rand -base64 32
CRON_SECRET=
# 32 bytes for AES-256-GCM integration tokens. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# System email (digest, alerts) until Gmail is connected
RESEND_API_KEY=
EMAIL_FROM="AgencyOS <onboarding@resend.dev>"

# Public URL of this dashboard, e.g. https://app.yourdomain.com
APP_URL=http://localhost:3000

# ---- Phase 3: only when each integration is switched on (README → Integrations) ----
# Meta: the System User token is pasted on the Integrations page (stored encrypted), not here.
META_APP_ID=
META_APP_SECRET=
# META_API_VERSION=v26.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# KEY_ID:KEY_SECRET
HIGGSFIELD_API_KEY=
# HIGGSFIELD_VIDEO_MODEL=higgsfield-ai/dop/standard
# HIGGSFIELD_IMAGE_MODEL=
# Sandbox needs no account/key (WiPay's public test account). Live needs both.
WIPAY_ACCOUNT_NUMBER=
WIPAY_API_KEY=
WIPAY_ENVIRONMENT=sandbox
# Test-only overrides (local stand-ins). Never set in production:
# META_GRAPH_URL= WIPAY_BASE_URL= HIGGSFIELD_BASE_URL= GOOGLE_AUTH_URL= GOOGLE_TOKEN_URL= GMAIL_API_URL= CALENDAR_API_URL=

# Phase 2: storage bucket (private) and the Business ID clients add as a partner
STORAGE_BUCKET=agencyos
AGENCY_META_BUSINESS_ID=
