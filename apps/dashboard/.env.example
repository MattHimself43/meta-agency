# Copy to .env.local (local dev) and set the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → Database → Connection string. Use the transaction pooler (port 6543) on Vercel.
DATABASE_URL=postgres://postgres.YOUR-PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# AI drafts (Phase 1+)
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-sonnet-5-5
AI_MODEL_DEEP=claude-opus-5-5

# Protects /api/cron/dispatch. Generate: openssl rand -base64 32
CRON_SECRET=
# 32 bytes for AES-256-GCM integration tokens. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# System email (digest, alerts) until Gmail is connected
RESEND_API_KEY=
EMAIL_FROM="AgencyOS <onboarding@resend.dev>"

# Public URL of this dashboard, e.g. https://app.yourdomain.com
APP_URL=http://localhost:3000

# ---- Phase 3: only when each integration is switched on ----
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HIGGSFIELD_API_KEY=
WIPAY_ACCOUNT_NUMBER=
WIPAY_API_KEY=
WIPAY_ENVIRONMENT=sandbox
